#!/usr/bin/env bash
# Model-specific config for Qwen3.8-Flash-Next (Qwen4-Exp)
# Sourced by configs/model.env — do not source directly

# --- Model ---
MODEL_ID="orcarouter/Qwen3.8-Flash-Next-Uncensored-NVFP4"
MODEL_NAME="Qwen3.8-Flash-Next"
CALIBRATION_MODEL_ID="Qwen/Qwen3.8-Flash-Next"

# --- Architecture ---
NATIVE_CTX=262144

# --- NVFP4 checkpoint ---
NVFP4_CHECKPOINT="${NVFP4_CHECKPOINT:-${HOME}/.cache/huggingface/hub/models--orcarouter--Qwen3.8-Flash-Next-Uncensored-NVFP4/snapshots/c1209bda15a6bbc4c68b585e93d40c0d85f50306}"

# --- Direct PLE checkpoint reads ---
SGLANG_PLE_SAFETENSORS_DIR="${NVFP4_CHECKPOINT}"

# --- SGLang ---
SGLANG_PORT=8000

# --- Serving ---
MODEL_ALIAS="qwen3.8-flash-next"

# --- SGLang serving policy ---
SGLANG_ATTENTION_BACKEND="flashinfer"
SGLANG_KV_CACHE_DTYPE="${SGLANG_KV_CACHE_DTYPE-fp8_e4m3}"
SGLANG_FP8_GEMM_BACKEND="cutlass"
# Preserve the qualified atomic MoE finalize path; set false for deterministic A/B runs.
export SGLANG_FLASHINFER_MOE_FUSED_FINALIZE="${SGLANG_FLASHINFER_MOE_FUSED_FINALIZE:-true}"
# keep breakable as the recipe default; sglang@832ec39 BCG capture chokes on
# qwen4_exp's LogitsProcessorOutput return, so H100 TP8 runs override to
# tc_piecewise (no-colon: empty override is honored).
SGLANG_CUDA_GRAPH_BACKEND_DECODE="${SGLANG_CUDA_GRAPH_BACKEND_DECODE-breakable}"
SGLANG_CHUNKED_PREFILL_SIZE="8192"
SGLANG_MAX_PREFILL_TOKENS="8192"
SGLANG_ENABLE_MIXED_CHUNK="false"
SGLANG_NUM_CONTINUOUS_DECODE_STEPS="4"
SGLANG_MEM_FRACTION_STATIC="0.9"
SGLANG_PAGE_SIZE="64"
SGLANG_MAMBA_RADIX_CACHE_STRATEGY="extra_buffer"
SGLANG_MAMBA_TRACK_INTERVAL="64"
# slots scale with max-running-requests; extra_buffer reserves ~6 slots per
# request (active + checkpoint + COW) — measured: 18 slots silently caps
# running requests at 3. The cookbook 3/request pin is for extra_buffer_lazy.
# Set SGLANG_MAX_MAMBA_CACHE_SIZE to override the derived count.
SGLANG_MAMBA_SLOTS_PER_REQ="6"
SGLANG_MAMBA_SSM_DTYPE="bfloat16"
SGLANG_LINEAR_ATTN_DECODE_BACKEND="flashinfer"
SGLANG_LINEAR_ATTN_PREFILL_BACKEND="flashinfer"
SGLANG_LINEAR_ATTN_VERIFY_BACKEND="flashinfer"
# A/B measured twice 2026-09-07 (bs-cap 3 and bs-cap 6 builds): autotune ON is
# throughput-neutral and inflates boot from ~4 min to ~11 min (per-tier tuning).
SGLANG_DISABLE_FLASHINFER_AUTOTUNE="true"
SGLANG_MAX_RUNNING_REQUESTS="6"
# spec off: MTP spends ~5.7 GB (~460K KV tokens) on the 5.21 GB BF16 draft
# layer + spec graphs/buffers; the block below is preconfigured for re-enabling
SGLANG_SPECULATIVE_ALGORITHM="none"
SGLANG_SPECULATIVE_NUM_STEPS="3"
# <= 4: QSA compress ratio caps the pending index-key ring at one group
SGLANG_SPECULATIVE_NUM_DRAFT_TOKENS="4"
SGLANG_SPECULATIVE_EAGLE_TOPK="1"
# RecoverSSM: output-only WY verify + post-verify SSM state reconstruction
SGLANG_GDN_MTP_CACHE_MODE="${SGLANG_GDN_MTP_CACHE_MODE-none}"
# 1.0 = lossless: accepted output distribution equals non-speculative sampling.
# 0.3 is the reference's lossy-but-faster setting (~+20% C1 at temp>0).
SGLANG_SPECULATIVE_ACCEPT_THRESHOLD_SINGLE="1.0"
SGLANG_SPECULATIVE_ACCEPT_THRESHOLD_ACC="1.0"
# FR-Spec A/B knob: draft lm_head scores a 64K hot-token subset of the 248K
# vocab (~4x cheaper draft logits, verify stays exact). Benchmark against no-map
# before enabling; set to empty to disable.
#SGLANG_SPECULATIVE_TOKEN_MAP="${MODEL_CONFIG_DIR}/hot_tokens_64k.pt"
SGLANG_REASONING_PARSER="qwen3"
SGLANG_TOOL_CALL_PARSER="qwen3_coder"
SGLANG_SAMPLING_DEFAULTS="model"
SGLANG_ENABLE_CACHE_REPORT="true"
SGLANG_ALLOW_AUTO_TRUNCATE="true"

# --- HiCache (SSD prefix cache) ---
# direct io backend uses cudaMemcpyAsync (DMA engine), avoiding JIT GPU
# kernels that write to host pointers (fails on WSL where
# CanUseHostPointerForRegisteredMem=0).
SGLANG_ENABLE_HIERARCHICAL_CACHE="${SGLANG_ENABLE_HIERARCHICAL_CACHE:-true}"
SGLANG_HICACHE_SIZE="${SGLANG_HICACHE_SIZE:-15}"
# Persist reused prefixes without writing one-use branches to SSD.
SGLANG_HICACHE_WRITE_POLICY="${SGLANG_HICACHE_WRITE_POLICY:-write_through_selective}"
# Measured safe capacity used to keep the host MAMBA tier at least as large
# as the derived device slot count.
SGLANG_HICACHE_MAMBA_SLOTS_PER_GB="3"
SGLANG_HICACHE_IO_BACKEND="direct"
SGLANG_HICACHE_MEM_LAYOUT="page_first_direct"
# File-backend direct mode is strict O_DIRECT for L2 host memory <-> L3 SSD.
export SGLANG_HICACHE_FILE_BACKEND_IO_MODE="direct"
export SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE="50G"
export SGLANG_HICACHE_FILE_BACKEND_EVICTION_RATIO="0.9"
export SGLANG_HICACHE_FILE_BACKEND_MIN_FREE_SPACE="50G"

# --- Benchmark sampling ---
BENCH_TEMPERATURE="1.0"
BENCH_TOP_K="20"
BENCH_TOP_P="0.95"
BENCH_REASONING_EFFORT="medium"
BENCH_ENABLE_THINKING="true"
