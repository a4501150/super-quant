#!/usr/bin/env bash
# Model-specific config for Qwen3.8-Flash-Next (Qwen4-Exp)
# Sourced by configs/model.env — do not source directly

# --- Model ---
MODEL_ID="orcarouter/Qwen3.8-Flash-Next-Uncensored-NVFP4"
MODEL_NAME="Qwen3.8-Flash-Next"
CALIBRATION_MODEL_ID="Qwen/Qwen3.8-Flash-Next"

# --- Architecture ---
NATIVE_CTX=262144

# --- NVFP4 checkpoint ---
NVFP4_CHECKPOINT="${NVFP4_CHECKPOINT:-${HOME}/.cache/huggingface/hub/models--orcarouter--Qwen3.8-Flash-Next-Uncensored-NVFP4/snapshots/c1209bda15a6bbc4c68b585e93d40c0d85f50306}"

# --- Serving ---
MODEL_ALIAS="qwen3.8-flash-next"

# --- Infernix (make serve-infernix) ---
INFERNIX_BIN="${INFERNIX_BIN:-${HOME}/src/ninferpro/build/apps/infernix-serve}"
INFERNIX_MODEL_DIR="${INFERNIX_MODEL_DIR:-${HOME}/models/infernix}"
INFERNIX_ARTIFACT="${INFERNIX_ARTIFACT:-${INFERNIX_MODEL_DIR}/Qwen3.8-Flash-Next-Uncensored-NVFP4-Infernix.infernix}"
# Chat template with the added close-thinking-before-calls instruction in the tool reminder;
# the artifact's embedded template stays the fallback when this file is absent.
INFERNIX_CHAT_TEMPLATE="${INFERNIX_CHAT_TEMPLATE:-${MODEL_CONFIG_DIR}/chat_template.jinja}"
INFERNIX_NGRAM_VOLUME="${INFERNIX_NGRAM_VOLUME:-${INFERNIX_MODEL_DIR}/Qwen3.8-Flash-Next-BF16.ngram}"
INFERNIX_DRAFT_MODEL="${INFERNIX_DRAFT_MODEL:-${INFERNIX_MODEL_DIR}/Qwen3.8-Flash-Next-DFlash2-Infernix.infernix}"
# Drafter mode passed to --spec (serve_infernix.sh and the infernix benches read it).
INFERNIX_SPEC="${INFERNIX_SPEC:-dflash2}"
INFERNIX_PORT="${INFERNIX_PORT:-8000}"
INFERNIX_HOST="${INFERNIX_HOST:-0.0.0.0}"
# fp8 KV: within 0.0013 mean KL of int8 and ~12% faster decode (fp8-a8-pair fast path).
INFERNIX_KV_DTYPE="${INFERNIX_KV_DTYPE:-fp8}"
# Vision tower ships in the artifact; the engine needs --vision to allocate it
# and accept media (otherwise HTTP 400 vision_disabled). The tower stays in
# pinned RAM (--vision-offload auto) and borrows expert frames only while
# encoding.
INFERNIX_VISION="${INFERNIX_VISION:-true}"
INFERNIX_MAX_CONTEXT="${INFERNIX_MAX_CONTEXT:-262144}"
INFERNIX_MAX_CONCURRENCY="${INFERNIX_MAX_CONCURRENCY:-6}"
# Prefix cache: RAM tier (MiB; 0 turns it off) and the SSD tier kept across restarts (empty: none).
# With the RAM tier, repeats resume from RAM, and a background writer copies every retained snapshot
# to the SSD so a full RAM tier drops copies the SSD holds (ninferpro hybrid-prefix-cache-spec
# §17.1); set INFERNIX_PREFIX_CACHE_DISK= to run RAM-only and spare the SSD those writes. The
# 2026-10-29 T3 (results/infernix_t3_prefix_disk.md) measured restarts resuming 20.8k-token
# prompts from the SSD in 54-60 ms against 1.7-1.8 s cold. 2026-11-01: disk tier off at the
# owner's call (no-colon default: an explicit empty env override is honored); the stale
# SSD cache was removed then. Uncomment the two lines to re-enable.
#INFERNIX_PREFIX_CACHE_DISK="${INFERNIX_PREFIX_CACHE_DISK:-${INFERNIX_MODEL_DIR}/prefix-cache}"
#INFERNIX_PREFIX_CACHE_DISK_GIB="${INFERNIX_PREFIX_CACHE_DISK_GIB:-64}"
INFERNIX_HOST_CONTEXT_MIB="${INFERNIX_HOST_CONTEXT_MIB:-8192}"
INFERNIX_PREFIX_CACHE_DISK="${INFERNIX_PREFIX_CACHE_DISK-}"
INFERNIX_PREFIX_CACHE_DISK_GIB="${INFERNIX_PREFIX_CACHE_DISK_GIB:-64}"
# Expert placement (vram=N,ram=M; the rest on SSD). Empty keeps the engine default.
INFERNIX_EXPERTS="${INFERNIX_EXPERTS:-}"
INFERNIX_EXTRA_ARGS="${INFERNIX_EXTRA_ARGS:-}"
# Gaming profile (make infernix-gaming): what a game may take.
INFERNIX_GAMING_RESERVE_VRAM_GB="${INFERNIX_GAMING_RESERVE_VRAM_GB:-32}"
INFERNIX_GAMING_RESERVE_RAM_GB="${INFERNIX_GAMING_RESERVE_RAM_GB:-24}"
