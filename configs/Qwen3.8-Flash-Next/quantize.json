{
  "source": {
    "model_id": "Qwen/Qwen3.8-Flash-Next",
    "task": "image-text-to-text",
    "trust_remote_code": false
  },
  "save": {
    "shard_size": "4GB"
  },
  "runtime": {
    "batch_size": 8,
    "dataloader_num_workers": 8,
    "sequential_targets_per_subgraph": 16,
    "sequential_prefetch": true,
    "enable_compile": true,
    "parallel_onload_workers": "auto"
  },
  "awq_prescale": {
    "calibration": {
      "domains": [
        "general",
        "code",
        "reasoning",
        "agentic"
      ],
      "token_budget": 131072,
      "sequence_length": 2048,
      "domain_weights": {
        "general": 0.35,
        "code": 0.25,
        "reasoning": 0.25,
        "agentic": 0.15
      },
      "minimum_achieved_ratio": 0.98
    },
    "mappings": [
      {
        "smooth_layer": "re:.*mlp\\.(experts\\.\\d+|shared_expert)\\.up_proj$",
        "balance_layers": [
          "re:.*mlp\\.(experts\\.\\d+|shared_expert)\\.down_proj$"
        ]
      }
    ],
    "duo_scaling": true,
    "n_grid": 20,
    "temporary_scheme": "W4A16_ASYM",
    "targets": [
      "re:.*layers\\.\\d+\\.self_attn\\.(q|k|v|o)_proj$",
      "re:.*layers\\.\\d+\\.linear_attn\\.(in_proj_qkv|in_proj_z|out_proj)$",
      "re:.*layers\\.\\d+\\.mlp\\.(experts\\.\\d+|shared_expert)\\.(gate|up|down)_proj$"
    ],
    "ignore": [
      "lm_head",
      "re:.*embed_tokens$",
      "re:.*visual.*",
      "re:.*mtp.*",
      "re:.*\\.ple\\..*",
      "re:.*indexer.*",
      "re:.*hyper_connection.*",
      "re:.*linear_attn\\.(in_proj_b|in_proj_a|conv1d|A_log|dt_bias|norm)$",
      "re:.*layernorm.*",
      "re:.*_norm$",
      "re:.*\\.norm\\.weight$"
    ]
  },
  "nvfp4": {
    "mappings": [
      {
        "smooth_layer": "re:.*mlp\\.(experts\\.\\d+|shared_expert)\\.up_proj$",
        "balance_layers": [
          "re:.*mlp\\.(experts\\.\\d+|shared_expert)\\.down_proj$"
        ]
      }
    ],
    "duo_scaling": true,
    "n_grid": 20,
    "groups": [
      {
        "name": "nvfp4_experts",
        "format": "nvfp4",
        "targets": [
          "re:.*layers\\.([0-9]|[1-3][0-9]|4[0-7])\\.mlp\\.experts\\.\\d+\\.(gate|up|down)_proj$"
        ]
      },
      {
        "name": "fp8_sensitive",
        "format": "fp8",
        "targets": [
          "lm_head",
          "re:.*self_attn\\.(q|k|v|o)_proj$",
          "re:.*linear_attn\\.(in_proj_qkv|in_proj_z|out_proj)$",
          "re:.*mlp\\.shared_expert\\.(gate|up|down)_proj$"
        ]
      }
    ],
    "ignore": [
      "re:.*embed_tokens$",
      "re:.*visual.*",
      "re:.*mtp.*",
      "re:.*\\.ple\\..*",
      "re:.*indexer.*",
      "re:.*hyper_connection.*",
      "re:.*linear_attn\\.(in_proj_b|in_proj_a|conv1d|A_log|dt_bias|norm)$",
      "re:.*layernorm.*",
      "re:.*_norm$",
      "re:.*\\.norm\\.weight$"
    ],
    "kv_cache": "fp8",
    "gptq": {
      "block_size": 128,
      "dampening_frac": 0.01,
      "actorder": "static",
      "offload_hessians": true
    },
    "weight_calibration": {
      "domains": [
        "general",
        "code",
        "reasoning",
        "agentic"
      ],
      "token_budget": 1048576,
      "sequence_length": 2048,
      "domain_weights": {
        "general": 0.35,
        "code": 0.25,
        "reasoning": 0.25,
        "agentic": 0.15
      },
      "minimum_achieved_ratio": 0.98
    },
    "kv_calibration": {
      "domains": [
        "general",
        "code",
        "reasoning",
        "agentic"
      ],
      "token_budget": 262144,
      "sequence_length": 8192,
      "domain_weights": {
        "general": 0.35,
        "code": 0.25,
        "reasoning": 0.25,
        "agentic": 0.15
      },
      "minimum_achieved_ratio": 0.98,
      "position_offsets": [
        0,
        32768,
        131072,
        253952
      ],
      "max_position": 262144
    },
    "expert_coverage": {
      "router_patterns": [
        "re:.*mlp\\.gate$"
      ],
      "output_index": 2,
      "num_experts_config_key": "num_experts",
      "top_k_config_key": "num_experts_per_tok",
      "token_budget": 131072,
      "minimum_tokens_per_expert": 32,
      "maximum_uncovered_experts": 0
    }
  }
}
