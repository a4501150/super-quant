#!/usr/bin/env bash
# Super-Quant: Central configuration for all scripts
# Source this file: source configs/model.env

# --- Model ---
MODEL_ID="AEON-7/Qwen3.6-27B-AEON-Ultimate-Uncensored-BF16"
MODEL_NAME="Qwen3.6-27B-AEON"

# --- Paths ---
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LLAMACPP_DIR="/home/jinyang/src/llama.cpp"
MODELS_DIR="${PROJECT_DIR}/models"
CALIBRATION_DIR="${PROJECT_DIR}/calibration"
RESULTS_DIR="${PROJECT_DIR}/results"

# --- Quantization targets ---
# All quants use UD (Unsloth Dynamic-style per-tensor overrides)
# K-quants for >=5 bit, IQ for <=4 bit (codebook method, better quality-per-bit)
QUANT_TYPES="Q8_0 Q6_K Q5_K_M IQ4_XS"

# --- GPU / Build ---
GPU_LAYERS=99
CUDA_ARCH="120"
THREADS=$(nproc)
CONTEXT_SIZE=8192
IMATRIX_CONTEXT_SIZE=32768

# --- MTP ---
MTP_ENABLED=true

# --- Calibration ---
# Per-domain token targets (general/code/reasoning/agentic)
# Set in Python config; override all domains with --tokens-per-domain flag
CALIBRATION_TOKENS_PER_DOMAIN=750000
CALIBRATION_DOMAINS="general code reasoning agentic"
# DI-MATRIX merge weights (general, code, reasoning, agentic)
# Equal weight per domain — the merge script normalizes automatically
IMATRIX_WEIGHTS="1.0 1.0 1.0 1.0"

# --- Derived paths ---
F16_GGUF="${MODELS_DIR}/${MODEL_NAME}-F16.gguf"
MMPROJ_GGUF="${MODELS_DIR}/${MODEL_NAME}-mmproj-F16.gguf"
BF16_DIR="${MODELS_DIR}/bf16"
IMATRIX_MERGED="${CALIBRATION_DIR}/imatrix_merged.dat"
IMATRIX_COMBINED="${CALIBRATION_DIR}/imatrix_combined.dat"
TENSOR_OVERRIDES="${PROJECT_DIR}/configs/tensor_overrides.txt"

# --- llama.cpp binaries ---
LLAMACPP_BUILD="${LLAMACPP_DIR}/build-blackwell"
LLAMA_QUANTIZE="${LLAMACPP_BUILD}/bin/llama-quantize"
LLAMA_IMATRIX="${LLAMACPP_BUILD}/bin/llama-imatrix"
LLAMA_SERVER="${LLAMACPP_BUILD}/bin/llama-server"
LLAMA_CLI="${LLAMACPP_BUILD}/bin/llama-cli"
LLAMA_PERPLEXITY="${LLAMACPP_BUILD}/bin/llama-perplexity"
CONVERT_SCRIPT="${LLAMACPP_DIR}/convert_hf_to_gguf.py"
