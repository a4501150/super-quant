#!/usr/bin/env bash
# Super-Quant: Central configuration
# Source this file: source configs/model.env
# To switch models: change MODEL_DIR below

# --- Active model ---
MODEL_DIR="Qwen3.8-27B-AEON"

# --- Machine / project ---
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LLAMACPP_DIR="/home/jinyang/src/llama.cpp"
GPU_LAYERS=99
CUDA_ARCH="120"
THREADS=$(nproc)

# --- Paths ---
MODELS_DIR="${SUPER_QUANT_MODELS:-${HOME}/models/gguf}"
CALIBRATION_DIR="${PROJECT_DIR}/calibration"
RESULTS_DIR="${PROJECT_DIR}/results"

# --- llama.cpp binaries ---
LLAMACPP_BUILD="${LLAMACPP_DIR}/build-blackwell"
LLAMA_QUANTIZE="${LLAMACPP_BUILD}/bin/llama-quantize"
LLAMA_SERVER="${LLAMACPP_BUILD}/bin/llama-server"
LLAMA_CLI="${LLAMACPP_BUILD}/bin/llama-cli"
LLAMA_PERPLEXITY="${LLAMACPP_BUILD}/bin/llama-perplexity"
CONVERT_SCRIPT="${LLAMACPP_DIR}/convert_hf_to_gguf.py"

# --- Source model-specific config ---
MODEL_CONFIG_DIR="${PROJECT_DIR}/configs/${MODEL_DIR}"
if [[ ! -f "${MODEL_CONFIG_DIR}/model.env" ]]; then
    echo "ERROR: Model config not found: ${MODEL_CONFIG_DIR}/model.env" >&2
    echo "Available models:" >&2
    for d in "${PROJECT_DIR}"/configs/*/; do
        [[ -f "${d}/model.env" ]] && echo "  $(basename "${d}")" >&2
    done
    return 1 2>/dev/null || exit 1
fi
source "${MODEL_CONFIG_DIR}/model.env"

# --- Derived paths ---
F16_GGUF="${MODELS_DIR}/${MODEL_NAME}-F16.gguf"
MMPROJ_GGUF="${MODELS_DIR}/${MODEL_NAME}-mmproj-F16.gguf"
IMATRIX_MERGED="${CALIBRATION_DIR}/imatrix_merged.dat"
IMATRIX_COMBINED="${CALIBRATION_DIR}/imatrix_combined.dat"
TENSOR_OVERRIDES="${MODEL_CONFIG_DIR}/tensor_overrides.txt"

# --- DFlash (derived, optional) ---
if [[ -n "${DFLASH_DRAFT_NAME:-}" ]]; then
    DFLASH_DRAFT_GGUF="${MODELS_DIR}/${DFLASH_DRAFT_NAME}-f16.gguf"
fi
