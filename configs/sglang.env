SGLANG_CUDA_VERSION="13.4"
SGLANG_CUDA_TAG="cu${SGLANG_CUDA_VERSION//./}"
SGLANG_ENV_REVISION="${SGLANG_CUDA_TAG}-20260915.1"
# Serving stack follows sglang main's own tested pins: STABLE torch (the
# cu134 channel is nightly-only, and torch nightly exports a newer
# c10_cuda_check_implementation signature that the PyPI sglang-kernel
# .so files cannot link against). nvcc stays 13.4 for JIT builds; the
# bundled runtime is 13.2 (minor-compatible within major 13).
# cu130 (not cu132): torchaudio imports hard-fail on a CUDA minor mismatch
# with torch, and its stable channel only ships cu130.
SGLANG_TORCH_CUDA_VERSION="13.0"
SGLANG_TORCH_CUDA_TAG="cu130"
SGLANG_TORCH_VERSION="2.13.0+${SGLANG_TORCH_CUDA_TAG}"
SGLANG_TORCHVISION_VERSION="0.28.0+${SGLANG_TORCH_CUDA_TAG}"  # pairs with torch 2.13
SGLANG_TORCHAUDIO_VERSION="2.11.0+${SGLANG_TORCH_CUDA_TAG}"
SGLANG_TORCHCODEC_VERSION="0.15.0+${SGLANG_TORCH_CUDA_TAG}"
SGLANG_KERNEL_VERSION="0.4.7"
SGLANG_DEEP_GEMM_VERSION="0.2.0"
# PyPI 0.1.2; only used by the EP/DP-attention path, which this launch
# shape does not enable.
SGLANG_DEEP_EP_VERSION="0.1.2"
SGLANG_PYTEST_VERSION="9.1.1"
SGLANG_TORCH_INDEX="https://download.pytorch.org/whl/${SGLANG_TORCH_CUDA_TAG}"
SGLANG_SOURCE_DIR="${SGLANG_SOURCE_DIR:-${HOME}/src/sglang}"
SGLANG_VENV="${SGLANG_VENV:-${HOME}/.venvs/sglang}"
