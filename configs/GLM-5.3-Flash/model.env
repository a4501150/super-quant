#!/usr/bin/env bash
# Model-specific config for GLM-5.3-Flash (ninferpro family glm5_next)
# Sourced by configs/model.env — do not source directly. Serve it with
# MODEL_DIR=GLM-5.3-Flash make serve-infernix.

# --- Model ---
MODEL_ID="orcarouter/GLM-5.3-Flash-Uncensored-NVFP4"
MODEL_NAME="GLM-5.3-Flash"

# --- Architecture ---
NATIVE_CTX=1048576

# --- Serving ---
MODEL_ALIAS="glm-5.3-flash"

# --- Infernix (make serve-infernix) ---
INFERNIX_BIN="${INFERNIX_BIN:-${HOME}/src/ninferpro/build/apps/infernix-serve}"
INFERNIX_MODEL_DIR="${INFERNIX_MODEL_DIR:-${HOME}/models/infernix}"
INFERNIX_ARTIFACT="${INFERNIX_ARTIFACT:-${INFERNIX_MODEL_DIR}/GLM-5.3-Flash-Uncensored-NVFP4-Infernix.infernix}"
INFERNIX_CHAT_TEMPLATE="${INFERNIX_CHAT_TEMPLATE:-}"
# No n-gram volume and no proposal head for this model.
INFERNIX_NGRAM_VOLUME=""
INFERNIX_LM_HEAD_DRAFT="false"
INFERNIX_DRAFT_MODEL="${INFERNIX_DRAFT_MODEL:-${INFERNIX_MODEL_DIR}/GLM-5.3-Flash-DFlash2-Infernix.infernix}"
INFERNIX_SPEC="${INFERNIX_SPEC:-dflash2}"
# GLM drafts a fixed length (no auto). At one stream K = 3 measured fastest (47.8 tok/s against
# 44.4 at K = 2 and 35.0 plain, 2026-11-24, ninferpro glm5_3-flash-design.md §16.3); rounds of
# several streams decode plainly.
INFERNIX_DRAFT_TOKENS="${INFERNIX_DRAFT_TOKENS:-3}"
INFERNIX_PORT="${INFERNIX_PORT:-8000}"
INFERNIX_HOST="${INFERNIX_HOST:-0.0.0.0}"
INFERNIX_KV_DTYPE="${INFERNIX_KV_DTYPE:-int8}"
INFERNIX_VISION="${INFERNIX_VISION:-false}"
INFERNIX_MAX_CONTEXT="${INFERNIX_MAX_CONTEXT:-262144}"
INFERNIX_MAX_CONCURRENCY="${INFERNIX_MAX_CONCURRENCY:-4}"
# The prefix cache's Host tier (the family's default; each GiB costs about 78 RAM expert slots).
# The family refuses the Disk tier.
INFERNIX_HOST_CONTEXT_MIB="${INFERNIX_HOST_CONTEXT_MIB:-2048}"
INFERNIX_PREFIX_CACHE_DISK=""
INFERNIX_PREFIX_CACHE_DISK_GIB="${INFERNIX_PREFIX_CACHE_DISK_GIB:-64}"
# VRAM policy: the whole process (dense weights, drafter, KV of every lane, workspace, expert
# frames) stays within 95 % of the card. KV is allocated for every lane at max_context at
# startup, so the expert share below is sized for INFERNIX_MAX_CONTEXT x INFERNIX_MAX_CONCURRENCY;
# re-measure it when either changes. 2026-11-24, 4 x 262144 INT8 with the drafter (K = 3) and the
# prefix cache (its KV holds every lane's full context: 6.36 GiB): vram=40% (4,838 frames) peaked
# at 92,412 MiB under four decodes beside a 9.4K prompt and its cached repeat (cap 92,993 MiB);
# vram=42% sat at 95,672 MiB.
INFERNIX_EXPERTS="${INFERNIX_EXPERTS:-vram=40%,ram=60%}"
INFERNIX_EXTRA_ARGS="${INFERNIX_EXTRA_ARGS:-}"
INFERNIX_REQUEST_LOG="${INFERNIX_REQUEST_LOG:-}"
INFERNIX_REQUEST_LOG_MAX_MIB="${INFERNIX_REQUEST_LOG_MAX_MIB:-256}"
INFERNIX_MONITOR_BIN="${INFERNIX_MONITOR_BIN:-${HOME}/src/ninferpro/build/apps/infernix-monitor}"
INFERNIX_MONITOR_HOST="${INFERNIX_MONITOR_HOST:-127.0.0.1}"
INFERNIX_MONITOR_PORT="${INFERNIX_MONITOR_PORT:-8090}"
INFERNIX_GAMING_RESERVE_VRAM_GB="${INFERNIX_GAMING_RESERVE_VRAM_GB:-32}"
INFERNIX_GAMING_RESERVE_RAM_GB="${INFERNIX_GAMING_RESERVE_RAM_GB:-24}"
