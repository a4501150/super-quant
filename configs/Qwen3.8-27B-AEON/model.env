#!/usr/bin/env bash
# Model-specific config for Qwen3.8-27B-AEON
# Sourced by configs/model.env — do not source directly

# --- Model ---
MODEL_ID="AEON-7/Qwen3.8-27B-AEON-ULTIMATE-UNCENSORED-BF16"
MODEL_NAME="Qwen3.8-27B-AEON"

# --- Architecture ---
NATIVE_CTX=262144
GGUF_ARCH_KEY="qwen35"

# --- Quantization targets ---
QUANT_TYPES="Q8_0 Q6_K Q5_K_M IQ4_XS"

# --- Speculative decoding ---
DSPARK_DRAFT_GGUF="${MODELS_DIR:-${HOME}/models/gguf}/Qwen3.8-27B-DSpark-BF16.gguf"

# --- NVFP4 (AWQ+GPTQ) ---
NVFP4_CHECKPOINT="${HOME}/models/nvfp4/${MODEL_NAME}-NVFP4"
NVFP4_GGUF="${MODELS_DIR:-${HOME}/models/gguf}/${MODEL_NAME}-NVFP4.gguf"

# --- SGLang / DFlash2 ---
DFLASH2_DRAFT_ID="z-lab/Qwen3.8-27B-DFlash2"
SGLANG_PORT=8888

# --- MTP (fallback) ---
MTP_ENABLED=true
MTP_N_MAX=3

# --- Serving ---
MODEL_ALIAS="qwen3.8-27b"
CHAT_TEMPLATE_FILE="${LLAMACPP_DIR}/models/templates/Qwen3.8-27B-sharp.jinja"

# --- Calibration ---
CALIBRATION_DOMAINS="general code reasoning agentic"
IMATRIX_WEIGHTS="1.0 1.0 1.0 1.0"

# --- Context ---
CONTEXT_SIZE=8192
IMATRIX_CONTEXT_SIZE=32768

# --- SGLang serving policy ---
SGLANG_ATTENTION_BACKEND="flashinfer"
SGLANG_KV_CACHE_DTYPE="fp8_e4m3"
SGLANG_FP8_GEMM_BACKEND="cutlass"
SGLANG_CUDA_GRAPH_BACKEND_DECODE="breakable"
SGLANG_CHUNKED_PREFILL_SIZE="2048"
SGLANG_MAX_PREFILL_TOKENS="2048"
SGLANG_ENABLE_MIXED_CHUNK="true"
SGLANG_NUM_CONTINUOUS_DECODE_STEPS="4"
SGLANG_MEM_FRACTION_STATIC="0.85"
SGLANG_MAX_RUNNING_REQUESTS="4"
SGLANG_SPECULATIVE_ALGORITHM="DFLASH"
SGLANG_SPECULATIVE_NUM_DRAFT_TOKENS="8"
SGLANG_SPECULATIVE_DRAFT_QUANTIZATION="unquant"
SGLANG_SPECULATIVE_DRAFT_ATTENTION_BACKEND="flashinfer"
SGLANG_REASONING_PARSER="qwen3"
SGLANG_TOOL_CALL_PARSER="qwen3_coder"
SGLANG_SAMPLING_DEFAULTS="model"
SGLANG_ENABLE_CACHE_REPORT="true"
SGLANG_ALLOW_AUTO_TRUNCATE="true"

# --- llama.cpp serving policy ---
LLAMA_REASONING_FORMAT="deepseek"
LLAMA_SPEC_TYPE_DEFAULT="dspark"
LLAMA_SPEC_DRAFT_N_MAX="7"

# --- Benchmark sampling (official Qwen3.8 recommendations) ---
BENCH_TEMPERATURE="1.0"
BENCH_TOP_K="20"
BENCH_TOP_P="0.95"
BENCH_REASONING_EFFORT="medium"
BENCH_ENABLE_THINKING="true"